# Variables de entorno del backend — configurar en Render > Environment
# No commitear este archivo con valores reales

# Orígenes permitidos para CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-frontend.vercel.app

# Clave secreta para firmar JWT (usar una cadena larga y aleatoria)
JWT_SECRET=

# Duración del token JWT en milisegundos (opcional, default 86400000 = 24h)
JWT_EXPIRATION_MS=86400000
